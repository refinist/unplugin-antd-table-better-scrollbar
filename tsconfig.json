{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "demo-ui/*": ["./node_modules/antdv4/es/*"],
      "original-table": ["./node_modules/antdv4/es/table/index.d.ts"],
      "original-react-table": ["./node_modules/antd/es/table/index.d.ts"],
      "table-under-test": ["./node_modules/antdv4/es/table/index.d.ts"],
      "unplugin-antd-table-better-scrollbar/vite/vue": ["./src/vite.ts"],
      "unplugin-antd-table-better-scrollbar/vite/react": ["./src/react/vite.ts"],
      "unplugin-antd-table-better-scrollbar/webpack/vue": ["./src/webpack.ts"],
      "unplugin-antd-table-better-scrollbar/webpack/react": ["./src/react/webpack.ts"],
      "unplugin-antd-table-better-scrollbar/rspack/vue": ["./src/rspack.ts"],
      "unplugin-antd-table-better-scrollbar/rspack/react": ["./src/react/rspack.ts"],
      "unplugin-antd-table-better-scrollbar": ["./src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "tests", "playground", "*.config.ts"]
}
